# Environment variables — only vars Omarchy's default envs.conf doesn't set.
# Omarchy sets (~/.local/share/omarchy/default/hypr/envs.conf): XDG_*,
# QT_QPA_PLATFORM, GDK_BACKEND, ELECTRON_OZONE_PLATFORM_HINT, XCOMPOSEFILE, etc.

{{ if eq .gpu "nvidia" -}}
# NVIDIA — Omarchy 3.8.3's nvidia env delivery is dead code (writes an
# unsourced file), so ALL NVIDIA vars live here. GBM_BACKEND deliberately
# unset (nobody sets it post-HyDE; first suspect if GBM misbehaves).
{{ if eq .machine "thinkpad-p1-gen4" -}}
# Performance Mode (BIOS Discrete Graphics)
# Requires: BIOS -> Config -> Display -> Graphics Device -> "Discrete Graphics"
# No AQ_DRM_DEVICES needed — only one GPU exists in discrete mode
{{ end -}}
env = NVD_BACKEND,direct
env = VDPAU_DRIVER,nvidia
env = __GL_MaxFramesAllowed,1
env = __GL_GSYNC_ALLOWED,1
env = MOZ_DISABLE_RDD_SANDBOX,1  # Required for Firefox NVIDIA VA-API hw decode
# New: previously supplied by HyDE (uwsm 01-gpu.sh / hypr nvidia.conf);
# Omarchy 3.8.3's nvidia env delivery is dead code (writes an unsourced file).
env = LIBVA_DRIVER_NAME,nvidia
env = __GLX_VENDOR_LIBRARY_NAME,nvidia
env = __GL_VRR_ALLOWED,1
{{ end -}}
