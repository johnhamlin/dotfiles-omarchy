# App launcher — Walker (Omarchy)
bindd = SUPER, SPACE, Launch apps, exec, omarchy-launch-walker
bindd = SUPER CTRL, E, Emoji picker, exec, omarchy-launch-walker -m symbols
bindd = SUPER CTRL, V, Clipboard manager, exec, omarchy-launch-walker -m clipboard

# Copy / Paste
# Hyprland 0.55 switched sendshortcut's parser to CVarList2, which strips
# trailing empty elements — so `..., CTRL, X,` now resolves to 2 args and
# fails with "invalid args" silently (no configerror). Workaround: pass the
# special `activewindow` token as the 3rd (window) arg.
# (Omarchy's own clipboard.conf ships the identical binds — not sourced.)
bindd = SUPER, C, Universal copy, sendshortcut, CTRL, Insert, activewindow
bindd = SUPER, V, Universal paste, sendshortcut, SHIFT, Insert, activewindow
bindd = SUPER, X, Universal cut, sendshortcut, CTRL, X, activewindow

# System / power menu — Omarchy menu (lock, restart, shutdown live here)
bindd = SUPER, ESCAPE, System menu, exec, omarchy-menu system
bindd = SUPER SHIFT, ESCAPE, Omarchy menu, exec, omarchy-menu
bindd = SUPER SHIFT, SPACE, Omarchy menu, exec, omarchy-menu
bindld = , XF86PowerOff, Lock screen, exec, loginctl lock-session

# Screenshots
bindd = , PRINT, Screenshot, exec, hyprshot -m region
bindd = SUPER SHIFT, PRINT, Screenshot to work WSL, exec, /home/john/.local/bin/shot2work
bindd = SUPER, PRINT, Color picker, exec, pkill hyprpicker || hyprpicker -a

# Waybar
bindd = SUPER ALT, SPACE, Toggle top bar, exec, omarchy-toggle-waybar

# Aesthetics
bindd = SUPER, BACKSPACE, Toggle window transparency, exec, omarchy-hyprland-window-transparency-toggle
bindd = SUPER CTRL SHIFT, W, Next theme background, exec, omarchy-theme-bg-next
bindd = SUPER CTRL SHIFT, T, Theme menu, exec, omarchy-menu theme

# Notifications — mako (was dunst)
bindd = SUPER, semicolon, Dismiss notification, exec, makoctl dismiss
bindd = SUPER SHIFT, semicolon, Dismiss all notifications, exec, makoctl dismiss --all
bindd = SUPER CTRL, semicolon, Toggle do-not-disturb, exec, omarchy-toggle-notification-silencing
bindd = SUPER ALT, semicolon, Restore last notification, exec, makoctl restore

# Toggles
bindd = SUPER CTRL, I, Toggle locking on idle, exec, omarchy-toggle-idle
bindd = SUPER CTRL, N, Toggle nightlight, exec, omarchy-toggle-nightlight
bindd = SUPER CTRL, G, Toggle game mode, exec, gaming-mode

# Control panels
bindd = SUPER CTRL, A, Audio controls, exec, uwsm-app -- pavucontrol
bindd = SUPER CTRL, B, Bluetooth controls, exec, uwsm-app -- blueman-manager
bindd = SUPER CTRL, W, Wifi controls, exec, uwsm-app -- nm-connection-editor
bindd = SUPER CTRL, T, Activity, exec, uwsm-app -- xdg-terminal-exec -e btop

# Dictation
bindd = SUPER CTRL, X, Toggle dictation, exec, voxtype record toggle

# Zoom
bindd = SUPER CTRL, Z, Zoom in, exec, hyprctl keyword cursor:zoom_factor $(hyprctl getoption cursor:zoom_factor -j | jq '.float + 1')
bindd = SUPER CTRL ALT, Z, Reset zoom, exec, hyprctl keyword cursor:zoom_factor 1

# Information
bindd = SUPER CTRL, K, Search keybindings, exec, omarchy-menu-keybindings
bindd = SUPER CTRL ALT, T, Show time, exec, notify-send "    $(date +"%A %H:%M  —  %d %B W%V %Y")"
bindd = , XF86Calculator, Calculator, exec, gnome-calculator

{{ if eq .formFactor "laptop" }}
# Hardware toggles
bindd = SUPER SHIFT, I, Toggle internal keyboard, exec, toggle-internal-keyboard
{{ end }}

# ─── Passthrough submap ──────────────────────────────────────────────
# Disables all Hyprland keybinds so keypresses flow to the focused
# window. Use for xfreerdp3 / VMs / anything that wants full keyboard
# capture. Toggle with SUPER+F12.
#
# Stuck? From a TTY or SSH:  hyprctl dispatch submap reset
#
# Must be the last thing in the last sourced bindings file — any
# `bind = ...` that appears after `submap = passthrough` would be
# swallowed into the submap instead of the global map.
bind = SUPER, F12, submap, passthrough
submap = passthrough
bind = SUPER, F12, submap, reset
submap = reset
