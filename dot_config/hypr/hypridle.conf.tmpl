{{ if eq .formFactor "laptop" -}}
general {
    lock_cmd = lock-screen
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = sleep 1 && hyprctl dispatch dpms on
    inhibit_sleep = 3
}

listener {
    timeout = 150                          # 2.5min
    on-timeout = loginctl lock-session     # lock directly
}

listener {
    timeout = 330                                            # 5.5min
    on-timeout = brightnessctl -sd '*::kbd_backlight' set 0  # turn off keyboard backlight
    on-resume = brightnessctl -rd '*::kbd_backlight'         # restore keyboard backlight
}

listener {
    timeout = 330                                            # 5.5min
    on-timeout = hyprctl dispatch dpms off                   # screen off
    on-resume = hyprctl dispatch dpms on && brightnessctl -r # screen on + restore brightness
}
{{ else -}}
general {
    lock_cmd = lock-screen
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = sleep 1 && hyprctl dispatch dpms on && pkill -x swaybg; setsid uwsm-app -- swaybg -i ~/.config/hypr/wallpaper.jpg -m fill &
    inhibit_sleep = 3
}

listener {
    timeout = 1800                         # 30min
    on-timeout = loginctl lock-session     # lock directly
}

listener {
    timeout = 1860                                           # 31min
    on-timeout = brightnessctl -sd '*::kbd_backlight' set 0  # turn off keyboard backlight
    on-resume = brightnessctl -rd '*::kbd_backlight'         # restore keyboard backlight
}

listener {
    timeout = 1860                                           # 31min
    on-timeout = hyprctl dispatch dpms off                   # screen off
    on-resume = hyprctl dispatch dpms on && brightnessctl -r # screen on + restore brightness
}
{{ end -}}
