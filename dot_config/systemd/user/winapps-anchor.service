[Unit]
Description=WinApps RAIL anchor (Outlook) - keeps freerdp session alive; mail window is the anchor app
Documentation=file:///home/john/notes/winapps-session-persistence.md
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
ExecStart=/home/john/.local/bin/winapps outlook-o365
Restart=always
RestartSec=10

[Install]
WantedBy=graphical-session.target
