{
  "$help": "Merge these settings into Windows Terminal's settings.json (Ctrl+Shift+, to open). Do not use this file directly — it is a reference for manual configuration.",
  "$schema": "https://aka.ms/terminal-profiles-schema",
  "defaultProfile": "{YOUR-WSL-UBUNTU-GUID}",
  "profiles": {
    "defaults": {
      "font": {
        "face": "JetBrainsMono Nerd Font",
        "size": 9
      },
      "padding": "14",
      "colorScheme": "One Half Dark"
    },
    "list": [
      {
        "name": "Ubuntu (tmux)",
        "source": "Windows.Terminal.Wsl",
        "commandline": "wsl.exe -d Ubuntu -- /usr/bin/fish -c 'tmux new-session -A -s main'",
        "startingDirectory": "~"
      }
    ]
  },
  "actions": [
    { "command": "unbound", "keys": "ctrl+h" },
    { "command": "unbound", "keys": "ctrl+j" },
    { "command": "unbound", "keys": "ctrl+k" },
    { "command": "unbound", "keys": "ctrl+l" },
    { "command": "unbound", "keys": "ctrl+b" },
    { "command": "unbound", "keys": "alt+h" },
    { "command": "unbound", "keys": "alt+l" },
    { "command": "unbound", "keys": "ctrl+shift+c" },
    { "command": "unbound", "keys": "ctrl+shift+v" },
    { "command": { "action": "copy", "singleLine": false }, "keys": "ctrl+insert" },
    { "command": "paste", "keys": "shift+insert" }
  ]
}
