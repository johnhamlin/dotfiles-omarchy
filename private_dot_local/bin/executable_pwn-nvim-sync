#!/usr/bin/env bash
# pwn-nvim-sync -- push John's LazyVim environment to the pwn.college dojo box.
#
# The dojo container (ssh host `pwn`, /home/hacker) has NO network, NO git, and
# NO node. So nothing can be installed there: the entire environment is rsynced
# from this desktop over SSH, and the parts that would reach for the network are
# neutralized by override files layered on top of the normal config.
#
# What gets pushed:
#   ~/.config/nvim                      -> pwn:~/.config/nvim   (minus dropped
#                                          plugin specs, plus override layer)
#   ~/.local/share/nvim/lazy            -> pwn:  (all plugins, pre-cloned)
#   ~/.local/share/nvim/site/{parser,queries} -> pwn:  (compiled TS parsers)
#   selected mason binaries            -> pwn:~/.local/bin + ~/.local/share
#
# Idempotent. Safe to re-run whenever the local config changes. The override
# sources live in ~/notes/pwn-college-nvim/overrides and are the source of
# truth for the dojo-only differences -- never edit config on the dojo box.
#
# Usage:
#   pwn-nvim-sync [--dry-run] [--verify-only] [--host NAME]
set -euo pipefail

HOST=pwn
DRY=()
VERIFY_ONLY=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY=(--dry-run); shift ;;
    --verify-only) VERIFY_ONLY=1; shift ;;
    --host) HOST="$2"; shift 2 ;;
    -h|--help) grep -E '^#( |$)' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

CFG="$HOME/.config/nvim"
DATA="$HOME/.local/share/nvim"
MASON="$DATA/mason/packages"
PROJECT="$HOME/notes/pwn-college-nvim"
OVERRIDES="$PROJECT/overrides"
STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT

# NOTE: there is no longer a `payload/` (it held ble.sh, dropped 2026-08-08) and
# no network fetch of any kind -- everything shipped now comes from this machine.

# rsync flags. -a preserves symlinks as-is. That is WRONG for site/queries/*:
# nvim-treesitter (main branch) installs each language's queries as a symlink
# site/queries/<lang> -> $HOME/.local/share/nvim/lazy/nvim-treesitter/runtime/
# queries/<lang>, i.e. an ABSOLUTE path under /home/john. The dojo home is
# /home/hacker, so a verbatim copy dangles -> highlights.scm is off the rtp ->
# the parser loads but paints nothing (Python et al. show as plain text; C/Lua
# survive only because Neovim bundles those queries in $VIMRUNTIME). The queries
# push below uses --copy-links to land them as real files, path-independent.
RS=(rsync -a --info=stats1 "${DRY[@]}")

# Plugin spec files that make no sense offline / on the dojo and are excluded
# from the config push. Everything else in lua/plugins is kept as-is.
CONFIG_EXCLUDES=(
  --exclude 'lua/plugins/diffview.lua'        # needs git
  --exclude 'lua/plugins/jupyter.lua'         # molten/image/quarto: node + venv
  --exclude 'lua/plugins/kitty-scrollback.lua' # needs the kitty kitten binary
  --exclude 'lua/plugins/leetcode.lua'        # network
  --exclude 'lua/plugins/minuet.lua'          # AI provider over network
  --exclude 'lua/plugins/obsidian.lua'        # vault path that doesn't exist
  --exclude 'lua/plugins/octo.lua'            # github + node
  --exclude 'lua/plugins/markdownlint.lua'    # markdownlint-cli2 is node
  --exclude 'lua/plugins/example.lua'         # LazyVim TS-centric template
  --exclude 'lua/plugins/.claude'             # unrelated
  --exclude '.git'
  --exclude '.gitignore'
)

require_override() {
  [[ -f "$1" ]] || { echo "missing override source: $1" >&2; exit 1; }
}

if [[ "$VERIFY_ONLY" -eq 0 ]]; then
  echo "==> staging nvim config"
  for f in \
    "$OVERRIDES/lua/config/lazy.lua" \
    "$OVERRIDES/lua/config/options.lua" \
    "$OVERRIDES/lua/plugins/zz-pwn-offline.lua" \
    "$OVERRIDES/lua/plugins/zz-pwn.lua" \
    "$OVERRIDES/lazyvim.json"; do
    require_override "$f"
  done

  # Base config into the staging dir, minus the dropped specs.
  rsync -a "${CONFIG_EXCLUDES[@]}" "$CFG/" "$STAGE/"
  # Layer the dojo-only overrides on top (these win).
  cp "$OVERRIDES/lua/config/lazy.lua"            "$STAGE/lua/config/lazy.lua"
  cp "$OVERRIDES/lua/config/options.lua"         "$STAGE/lua/config/options.lua"
  cp "$OVERRIDES/lua/plugins/zz-pwn-offline.lua" "$STAGE/lua/plugins/zz-pwn-offline.lua"
  cp "$OVERRIDES/lua/plugins/zz-pwn.lua"         "$STAGE/lua/plugins/zz-pwn.lua"
  cp "$OVERRIDES/lazyvim.json"                   "$STAGE/lazyvim.json"

  echo "==> [1/4] pushing config  ->  $HOST:~/.config/nvim"
  ssh "$HOST" 'mkdir -p ~/.config/nvim ~/.local/share/nvim/site ~/.local/bin ~/.local/share'
  "${RS[@]}" --delete \
    --exclude 'lua/plugins/zz-pwn-local.lua' \
    "$STAGE/" "$HOST:.config/nvim/"

  echo "==> [2/4] pushing plugins ->  $HOST:~/.local/share/nvim/lazy  (~284M, first run only)"
  "${RS[@]}" "$DATA/lazy/" "$HOST:.local/share/nvim/lazy/"

  echo "==> [3/4] pushing treesitter parsers + queries"
  "${RS[@]}" "$DATA/site/parser"  "$HOST:.local/share/nvim/site/"
  # --copy-links: dereference the per-language query symlinks into real files so
  # they don't dangle under the dojo's /home/hacker (see RS comment above).
  # --delete so a stale dangling symlink from an earlier sync is replaced.
  "${RS[@]}" --copy-links --delete "$DATA/site/queries" "$HOST:.local/share/nvim/site/"

  echo "==> [4/4] pushing LSP servers / formatters -> $HOST:~/.local/bin"
  # Direct single-file ELF binaries: ship the resolved real file.
  for name in stylua shellcheck shfmt; do
    real="$(readlink -f "$DATA/mason/bin/$name" 2>/dev/null || true)"
    if [[ -n "$real" && -f "$real" ]]; then
      "${RS[@]}" "$real" "$HOST:.local/bin/$name"
    else
      echo "   warn: $name not found locally, skipping" >&2
    fi
  done
  # lua-language-server: ships as a package tree + a regenerated wrapper,
  # because the mason wrapper hardcodes the local /home/john path.
  if [[ -d "$MASON/lua-language-server/libexec" ]]; then
    "${RS[@]}" --delete "$MASON/lua-language-server/libexec/" \
      "$HOST:.local/share/lua-language-server/"
    ssh "$HOST" 'cat > ~/.local/bin/lua-language-server <<'"'"'EOF'"'"'
#!/usr/bin/env bash
exec "$HOME/.local/share/lua-language-server/bin/lua-language-server" "$@"
EOF
chmod +x ~/.local/bin/lua-language-server'
  fi

  echo "==> [5/6] pushing tmux config -> $HOST:~/.config/tmux/tmux.conf"
  # Self-contained single file, no TPM plugins. The dojo runs tmux 3.6a, newer
  # than every version-gated option in it (extended-keys, terminal-features,
  # allow-passthrough, swap-pane {left-of}), so it ships verbatim. The
  # @pane-is-vim smart-splits bindings pair with the deployed nvim; the fish
  # kitty-passthrough helper is fish-only and simply inert under the dojo's bash.
  if [[ -f "$HOME/.config/tmux/tmux.conf" ]]; then
    ssh "$HOST" 'mkdir -p ~/.config/tmux'
    "${RS[@]}" "$HOME/.config/tmux/tmux.conf" "$HOST:.config/tmux/tmux.conf"
  else
    echo "   warn: ~/.config/tmux/tmux.conf not found locally, skipping" >&2
  fi

  echo "==> [6/6] pushing bash env (~/.bashrc + ~/.inputrc + prompt)"
  # bash stays the shell here (pwn.college is bash-centric). Interactive polish
  # is NATIVE readline (vi mode + prefix history search + menu completion in
  # ~/.inputrc) plus fzf/zoxide/starship. ble.sh was removed 2026-08-08 -- see
  # the header of overrides/bashrc and dead end #8 in the README.
  ssh "$HOST" 'rm -rf ~/.local/share/blesh'   # remove a previously-synced ble.sh
  ssh "$HOST" 'mkdir -p ~/.config'
  "${RS[@]}" "$OVERRIDES/bashrc"       "$HOST:.bashrc"
  "${RS[@]}" "$OVERRIDES/inputrc"      "$HOST:.inputrc"
  # A login shell (what `ssh pwn` starts) reads .bash_profile, NOT .bashrc.
  "${RS[@]}" "$OVERRIDES/bash_profile" "$HOST:.bash_profile"
  # starship prompt: default config path is ~/.config/starship.toml (no env var
  # needed). Leads with the hostname = the loaded challenge.
  "${RS[@]}" "$OVERRIDES/starship.toml" "$HOST:.config/starship.toml"

  if [[ ${#DRY[@]} -gt 0 ]]; then
    echo "==> dry run complete; skipping verification"
    exit 0
  fi
fi

echo
echo "======================================================================"
echo "  VERIFICATION  (running on $HOST)"
echo "======================================================================"

# The verifier runs headless nvim and prints PASS/FAIL lines. It exits nonzero
# if any hard check fails so the script's own exit status is meaningful.
# The verifier is written to a remote temp file and executed with stdin
# detached (</dev/null). Piping the script straight into `bash -s` makes every
# child process (nvim in particular) inherit the heredoc as stdin and eat the
# rest of the script. `cat > file` drains the heredoc to EOF first, then bash
# runs it clean.
ssh "$HOST" 'cat > /tmp/pwn-nvim-verify.sh && PATH="$HOME/.local/bin:$PATH" bash /tmp/pwn-nvim-verify.sh </dev/null; rc=$?; rm -f /tmp/pwn-nvim-verify.sh; exit $rc' <<'REMOTE'
set -u
fail=0
say() { printf '%-58s %s\n' "$1" "$2"; }

# 1. Clean startup -- this is the exact failure we are fixing.
err="$(nvim --headless -c 'qa' </dev/null 2>&1 | tr -d '\033' | grep -viE 'IS_NVIM|SetUserVar' || true)"
if [[ -z "$err" ]]; then say "startup (headless, no errors)" "PASS"; else
  say "startup (headless, no errors)" "FAIL"; echo "$err" | sed 's/^/      /'; fail=1; fi

# 2. Parser load: every compiled parser must load into this nvim build.
nvim --headless -c 'lua
  local dir = vim.fn.expand("~/.local/share/nvim/site/parser")
  local bad = {}
  for _, so in ipairs(vim.fn.glob(dir.."/*.so", true, true)) do
    local lang = vim.fn.fnamemodify(so, ":t:r")
    local ok = pcall(vim.treesitter.language.add, lang)
    if not ok then table.insert(bad, lang) end
  end
  local n = #vim.fn.glob(dir.."/*.so", true, true)
  if #bad == 0 then print(("PARSERS_OK %d"):format(n))
  else print("PARSERS_BAD "..table.concat(bad, ",")) end
' -c 'qa' </dev/null 2>&1 | tr -d '\033' | grep -aE 'PARSERS_(OK|BAD)' | while read -r line; do
  if [[ "$line" == PARSERS_OK* ]]; then say "treesitter parsers load (${line#PARSERS_OK })" "PASS"
  else say "treesitter parsers load" "FAIL: $line"; fi
done

# 2b. Highlight QUERIES resolve. A parser can load fine yet paint nothing if its
#     highlights.scm is off the runtimepath -- exactly what happened when the
#     site/queries/<lang> symlinks were copied verbatim and dangled under
#     /home/hacker. Neovim-bundled langs (c/lua/...) have a $VIMRUNTIME fallback
#     and would mask the failure, so probe langs that ONLY nvim-treesitter ships.
nvim --headless -c 'lua
  local want = {"python","rust","go","bash","asm"}
  local bad = {}
  for _, l in ipairs(want) do
    if not vim.treesitter.query.get(l, "highlights") then table.insert(bad, l) end
  end
  if #bad == 0 then print(("QUERIES_OK %d"):format(#want))
  else print("QUERIES_BAD "..table.concat(bad, ",")) end
' -c 'qa' </dev/null 2>&1 | tr -d '\033' | grep -aE 'QUERIES_(OK|BAD)' | while read -r line; do
  if [[ "$line" == QUERIES_OK* ]]; then say "treesitter highlight queries resolve (${line#QUERIES_OK })" "PASS"
  else say "treesitter highlight queries resolve" "FAIL: missing ${line#QUERIES_BAD }"; fi
done

# 3. LSP attaches per language. Open a real file of each type headless, wait for
#    the FileType/LspAttach cycle, and report the attached client.
check_lsp() {
  local ft="$1" ext="$2" want="$3"
  local tmp="/tmp/pwnlsp.$ext"
  case "$ext" in
    c)  printf 'int main(void){return 0;}\n' > "$tmp" ;;
    rs) printf 'fn main() {}\n' > "$tmp" ;;
    py) printf 'x = 1\n' > "$tmp" ;;
    lua) printf 'local x = 1\n' > "$tmp" ;;
  esac
  local got
  got="$(nvim --headless "$tmp" -c 'lua
    vim.wait(8000, function()
      return #vim.lsp.get_clients({ bufnr = 0 }) > 0
    end, 100)
    local names = {}
    for _, c in ipairs(vim.lsp.get_clients({ bufnr = 0 })) do names[#names+1] = c.name end
    print("LSP="..table.concat(names, ","))
  ' -c 'qa' </dev/null 2>&1 | tr -d '\033' | grep -aoE 'LSP=[a-z_,-]*' | head -1)"
  rm -f "$tmp"
  got="${got#LSP=}"
  if [[ ",$got," == *",$want,"* ]]; then say "LSP $ft -> $want" "PASS ($got)"
  else say "LSP $ft -> $want" "FAIL (got: ${got:-none})"; fail=1; fi
}
check_lsp C        c   clangd
check_lsp Python   py  ruff
check_lsp Lua      lua lua_ls
# Rust LSP: the dojo provides rust-analyzer/rustc/cargo only as rustup shims
# with NO default toolchain installed, and no network to `rustup default`. So
# rust-analyzer exits immediately and cannot attach. rust_analyzer is left
# enabled (it will just work if a toolchain ever appears) and treesitter still
# highlights Rust -- but LSP is genuinely unavailable, so this is SKIP not FAIL.
if rust-analyzer --version >/dev/null 2>&1; then
  check_lsp Rust rs rust_analyzer
else
  say "LSP Rust (no rust toolchain on dojo)" "SKIP"
fi

# 4. blink.cmp uses the compiled Rust fuzzy matcher, not the lua fallback.
impl="$(nvim --headless -c 'lua
  local ok, fuzzy = pcall(require, "blink.cmp.fuzzy")
  local rok = ok and pcall(function() return require("blink.cmp.fuzzy.rust") end)
  print("FUZZY="..(rok and "rust" or "lua"))
' -c 'qa' </dev/null 2>&1 | tr -d '\033' | grep -aoE 'FUZZY=(rust|lua)' | head -1)"
if [[ "$impl" == "FUZZY=rust" ]]; then say "blink.cmp fuzzy = rust" "PASS"
else say "blink.cmp fuzzy = rust" "WARN (${impl:-unknown}; lua fallback works, just slower)"; fi

# 5. Pwn tooling reachable on PATH.
for t in gcc gdb checksec ROPgadget objdump python3; do
  if command -v "$t" >/dev/null; then say "tool: $t" "PASS"; else say "tool: $t" "FAIL"; fail=1; fi
done
python3 -c 'import pwn' 2>/dev/null && say "python: import pwn (pwntools)" "PASS" || { say "python: pwntools" "FAIL"; fail=1; }

# 6. asm parser + man section 2 (the two pwn-layer externals).
nvim --headless -c 'lua print("ASM="..tostring(pcall(vim.treesitter.language.add,"asm")))' -c 'qa' </dev/null 2>&1 \
  | tr -d '\033' | grep -aq 'ASM=true' && say "asm treesitter parser" "PASS" || say "asm treesitter parser" "FAIL"
man 2 read >/dev/null 2>&1 && say "man 2 (syscall lookup)" "PASS" || say "man 2 (syscall lookup)" "FAIL"

# 7. pwntools snippets actually register (LuaSnip's fmta is strict: one unused
#    node arg silently aborts the whole add_snippets block).
snip="$(nvim --headless -c 'lua
  require("lazy").load({ plugins = { "LuaSnip" } })
  vim.wait(800)
  local snips = require("luasnip").get_snippets("python") or {}
  local have = {}
  for _, s in ipairs(snips) do have[s.trigger] = true end
  local ok = have.pwn and have.rop and have.sla and have.p64 and have.gdba
  print("SNIPPETS="..(ok and "ok" or "missing").." ("..#snips.." python)")
' -c 'qa' </dev/null 2>&1 | tr -d '\033' | grep -aoE 'SNIPPETS=[a-z]+ \([0-9]+ python\)' | head -1)"
if [[ "$snip" == SNIPPETS=ok* ]]; then say "pwntools snippets registered ${snip#SNIPPETS=ok }" "PASS"
else say "pwntools snippets" "FAIL ($snip)"; fail=1; fi

# 8. Build binding produces an unmitigated binary (no-PIE + exec stack).
bdir="$(mktemp -d)"
printf 'int main(void){return 0;}\n' > "$bdir/c.c"
nvim --headless "$bdir/c.c" \
  -c 'lua vim.api.nvim_feedkeys(vim.api.nvim_replace_termcodes(" kb", true, false, true), "mx", false)' \
  -c 'sleep 2' -c 'qa' </dev/null >/dev/null 2>&1
if [[ -x "$bdir/c" ]] && readelf -lW "$bdir/c" 2>/dev/null | grep -q 'GNU_STACK.*RWE' \
   && ! file "$bdir/c" | grep -q 'pie executable'; then
  say "<leader>kb builds unmitigated binary (no-pie, execstack)" "PASS"
else say "<leader>kb build flags" "FAIL"; fail=1; fi
rm -rf "$bdir"

# 9. tmux sources its config with no parse errors (a bad option aborts sourcing
#    at that line, silently dropping every binding below it). Use a throwaway
#    server socket so this never touches a real session.
if command -v tmux >/dev/null; then
  terr="$(tmux -L pwnverify -f "$HOME/.config/tmux/tmux.conf" new-session -d -s v 'sleep 2' 2>&1)"
  tmux -L pwnverify kill-server >/dev/null 2>&1
  if [[ -z "$terr" ]]; then say "tmux config sources cleanly" "PASS"
  else say "tmux config" "FAIL: $terr"; fail=1; fi
else
  say "tmux (not on box)" "FAIL"; fail=1
fi

# 10. bash env. ble.sh was removed 2026-08-08 (README dead end #8), so this now
#     verifies the NATIVE readline setup instead:
#   a) the rc files parse;
#   b) the login-shell WIRING is connected: `ssh pwn` -> login shell ->
#      .bash_profile -> .bashrc -> vi mode + prompt + protocol heal;
#   c) readline actually has the vi-mode binds from ~/.inputrc;
#   d) no ble.sh remnants are left on the box.
berr="$(bash -n ~/.bashrc 2>&1; bash -n ~/.bash_profile 2>&1)"
if [[ -n "$berr" ]]; then say "bash config syntax" "FAIL: $berr"; fail=1
else say "bash config syntax" "PASS"; fi

wire_ok=1
grep -q '~/.bashrc' ~/.bash_profile || wire_ok=0            # profile -> bashrc
grep -q 'set -o vi' ~/.bashrc || wire_ok=0                  # vi mode
grep -q '__heal_kbd_protocol' ~/.bashrc || wire_ok=0        # CSI-u leak heal
grep -q 'starship init bash' ~/.bashrc || wire_ok=0         # prompt
[[ $wire_ok -eq 1 ]] && say "login chain wired (.bash_profile->.bashrc, vi, kbd-heal, prompt)" "PASS" \
  || { say "login chain wiring" "FAIL"; fail=1; }
command -v fzf >/dev/null && say "fzf present (C-r fuzzy history)" "PASS" || { say "fzf" "FAIL"; fail=1; }

# 10b. readline really loaded ~/.inputrc: ask bash to dump its binds and confirm
#      the vi-insert prefix-history-search binding is actually live. This is the
#      thing ble.sh used to provide, so it must not silently go missing.
rl="$(bash -ic 'bind -m vi-insert -p 2>/dev/null' 2>/dev/null | grep -aE '^"\\C-p"' || true)"
if grep -q 'history-search-backward' <<<"$rl"; then
  say "readline vi-mode binds live (C-p prefix history search)" "PASS"
else
  say "readline vi-mode binds" "FAIL: C-p not bound to history-search-backward"; fail=1
fi

# 10c. ble.sh must be gone -- a stale tree would still be sourced by an old
#      .bashrc and reintroduce the CSI-u/fzf and Ctrl-C problems.
if [[ -e ~/.local/share/blesh ]] || grep -q 'blesh/ble.sh' ~/.bashrc 2>/dev/null; then
  say "ble.sh fully removed" "FAIL: remnants present"; fail=1
else
  say "ble.sh fully removed" "PASS"
fi

# 11. starship prompt actually renders the hostname (the loaded challenge) and
#     NOT the [Docker] container label.
if command -v starship >/dev/null; then
  hn="$(hostname)"
  prompt="$(starship prompt 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g')"
  if [[ "$prompt" == *"$hn"* ]]; then say "prompt shows hostname ($hn)" "PASS"
  else say "prompt shows hostname" "FAIL (got: ${prompt:0:60})"; fail=1; fi
  [[ "$prompt" == *Docker* ]] && { say "  [Docker] label removed" "FAIL"; fail=1; } \
                             || say "  [Docker] label removed" "PASS"
else say "starship" "FAIL"; fail=1; fi

echo "----------------------------------------------------------------------"
[[ $fail -eq 0 ]] && echo "  RESULT: all hard checks passed" || echo "  RESULT: FAILURES above"
exit $fail
REMOTE
