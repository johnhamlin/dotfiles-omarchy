#!/bin/bash

# manage-webapps - Install, uninstall, and list webapps as .desktop entries
# Creates .desktop files that launch via launch-webapp in the default browser's --app mode.
# Webapps appear in rofi (Super+Space) alongside native applications.

set -euo pipefail

APPS_DIR="$HOME/.local/share/applications"
ICONS_BASE="$HOME/.local/share/icons/hicolor"
ICON_SIZES=(128 64 32)
PREFIX="webapp-"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_status() { echo -e "${BLUE}==>${NC} $1"; }
print_success() { echo -e "${GREEN}==>${NC} $1"; }
print_warning() { echo -e "${YELLOW}==>${NC} $1"; }
print_error() { echo -e "${RED}==>${NC} $1"; }

has_cmd() { command -v "$1" &>/dev/null; }

slugify() {
    echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g; s/--*/-/g; s/^-//; s/-$//'
}

domain_from_url() {
    echo "$1" | sed -E 's|^https?://||; s|^www\.||; s|/.*||; s|:.*||'
}

name_from_domain() {
    local domain="$1"
    local base="${domain%%.*}"
    # Capitalize first letter
    echo "${base^}"
}

# --- Icon handling ---

fetch_icon() {
    local slug="$1" domain="$2" icon_url="${3:-}"
    local tmp="/tmp/${PREFIX}${slug}-icon.tmp"
    local icon_name="web-browser"

    # Try explicit icon URL first, then Google favicon service
    local url="${icon_url:-https://www.google.com/s2/favicons?domain=${domain}&sz=128}"

    if curl -fsSL --max-time 10 -o "$tmp" "$url" 2>/dev/null && [[ -s "$tmp" ]]; then
        if has_cmd magick; then
            local installed=false
            for size in "${ICON_SIZES[@]}"; do
                local dir="$ICONS_BASE/${size}x${size}/apps"
                mkdir -p "$dir"
                if magick "$tmp" -resize "${size}x${size}" "$dir/${PREFIX}${slug}.png" 2>/dev/null; then
                    installed=true
                fi
            done
            if [[ "$installed" == true ]]; then
                icon_name="${PREFIX}${slug}"
            fi
        else
            # No ImageMagick -- install raw file at 128x128 if it looks like an image
            local dir="$ICONS_BASE/128x128/apps"
            mkdir -p "$dir"
            cp "$tmp" "$dir/${PREFIX}${slug}.png"
            icon_name="${PREFIX}${slug}"
        fi
        rm -f "$tmp"
    else
        rm -f "$tmp"
        if [[ -n "$icon_url" ]]; then
            print_warning "Failed to download icon, using default"
        fi
    fi

    echo "$icon_name"
}

remove_icons() {
    local slug="$1"
    for size in "${ICON_SIZES[@]}"; do
        rm -f "$ICONS_BASE/${size}x${size}/apps/${PREFIX}${slug}.png"
    done
}

update_db() {
    if has_cmd update-desktop-database; then
        update-desktop-database "$APPS_DIR" 2>/dev/null || true
    fi
}

# --- Install ---

cmd_install() {
    local name="" icon_url="" url=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name)  name="$2"; shift 2 ;;
            --icon)  icon_url="$2"; shift 2 ;;
            *)       url="$1"; shift ;;
        esac
    done

    if [[ -z "$url" ]]; then
        if has_cmd gum; then
            url=$(gum input --prompt "URL: " --placeholder "https://example.com")
        else
            read -rp "URL: " url
        fi
    fi

    if [[ -z "$url" ]]; then
        print_error "URL is required"
        exit 1
    fi

    # Ensure URL has a scheme
    if [[ "$url" != http://* && "$url" != https://* ]]; then
        url="https://$url"
    fi

    local domain
    domain=$(domain_from_url "$url")

    if [[ -z "$name" ]]; then
        local default_name
        default_name=$(name_from_domain "$domain")
        if has_cmd gum; then
            name=$(gum input --prompt "App name: " --value "$default_name")
        else
            read -rp "App name [$default_name]: " name
            name="${name:-$default_name}"
        fi
    fi

    local slug
    slug=$(slugify "$name")
    local desktop_file="$APPS_DIR/${PREFIX}${slug}.desktop"

    if [[ -f "$desktop_file" ]]; then
        if has_cmd gum; then
            gum confirm "Overwrite existing '$name'?" || exit 0
        else
            read -rp "Overwrite existing '$name'? [y/N] " -n 1
            echo
            [[ $REPLY =~ ^[Yy]$ ]] || exit 0
        fi
    fi

    print_status "Installing $name ($url)..."

    local icon_name
    icon_name=$(fetch_icon "$slug" "$domain" "$icon_url")

    mkdir -p "$APPS_DIR"
    cat > "$desktop_file" << EOF
[Desktop Entry]
Name=$name
Comment=Web app: $url
Exec=launch-webapp "$url"
Icon=$icon_name
Terminal=false
Type=Application
Categories=Network;WebBrowser;
StartupWMClass=$domain
Keywords=webapp;web;
EOF

    update_db
    print_success "Installed $name — available in app launcher"
}

# --- Uninstall ---

cmd_uninstall() {
    local target="${1:-}"
    local desktop_file=""

    if [[ -z "$target" ]]; then
        # Interactive selection
        local files=("$APPS_DIR"/${PREFIX}*.desktop)
        if [[ ! -f "${files[0]}" ]]; then
            print_warning "No webapps installed"
            exit 0
        fi

        local names=()
        for f in "${files[@]}"; do
            local n
            n=$(sed -n 's/^Name=//p' "$f")
            names+=("$n")
        done

        if has_cmd gum; then
            target=$(printf '%s\n' "${names[@]}" | gum choose --header "Select webapp to remove:")
        else
            echo "Installed webapps:"
            for i in "${!names[@]}"; do
                echo "  $((i+1)). ${names[$i]}"
            done
            read -rp "Number to remove: " idx
            target="${names[$((idx-1))]}"
        fi
    fi

    if [[ -z "$target" ]]; then
        exit 0
    fi

    # Find matching .desktop file by name or slug
    local slug
    slug=$(slugify "$target")
    desktop_file="$APPS_DIR/${PREFIX}${slug}.desktop"

    if [[ ! -f "$desktop_file" ]]; then
        # Try matching by Name= field
        for f in "$APPS_DIR"/${PREFIX}*.desktop; do
            [[ -f "$f" ]] || continue
            local n
            n=$(sed -n 's/^Name=//p' "$f")
            if [[ "$n" == "$target" ]]; then
                desktop_file="$f"
                slug=$(basename "$f" .desktop)
                slug="${slug#webapp-}"
                break
            fi
        done
    fi

    if [[ ! -f "$desktop_file" ]]; then
        print_error "Webapp not found: $target"
        exit 1
    fi

    local name
    name=$(sed -n 's/^Name=//p' "$desktop_file")

    rm -f "$desktop_file"
    remove_icons "$slug"
    update_db
    print_success "Removed $name"
}

# --- List ---

cmd_list() {
    local files=("$APPS_DIR"/${PREFIX}*.desktop)
    if [[ ! -f "${files[0]}" ]]; then
        echo "No webapps installed"
        return
    fi

    local max_name=0
    local entries=()
    for f in "${files[@]}"; do
        local name url
        name=$(sed -n 's/^Name=//p' "$f")
        url=$(sed -n 's/^Exec=launch-webapp "\(.*\)"/\1/p' "$f")
        entries+=("$name|$url")
        (( ${#name} > max_name )) && max_name=${#name}
    done

    for entry in "${entries[@]}"; do
        local name="${entry%%|*}"
        local url="${entry#*|}"
        printf "  %-${max_name}s  %s\n" "$name" "$url"
    done
}

# --- Interactive ---

interactive_mode() {
    if ! has_cmd gum; then
        echo "Usage: manage-webapps <install|uninstall|list>"
        exit 1
    fi

    local choice
    choice=$(gum choose --header "Webapps:" "install" "uninstall" "list")

    case "$choice" in
        install)   cmd_install ;;
        uninstall) cmd_uninstall ;;
        list)      cmd_list ;;
    esac
}

# --- Main ---

case "${1:-}" in
    install)          shift; cmd_install "$@" ;;
    uninstall|remove) shift; cmd_uninstall "$@" ;;
    list|ls)          cmd_list ;;
    -h|--help)
        echo "Usage: manage-webapps <command> [options]"
        echo ""
        echo "Commands:"
        echo "  install [--name \"Name\"] [--icon <url>] <url>"
        echo "  uninstall [name-or-slug]"
        echo "  list"
        echo ""
        echo "Without arguments, launches interactive mode."
        ;;
    "")               interactive_mode ;;
    *)
        print_error "Unknown command: $1"
        echo "Usage: manage-webapps <install|uninstall|list>"
        exit 1
        ;;
esac
