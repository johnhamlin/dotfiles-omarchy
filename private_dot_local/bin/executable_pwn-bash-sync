#!/usr/bin/env bash
# pwn-bash-sync -- two-way sync of the shell environment with the pwn.college dojo.
#
# pwn-nvim-sync ships ~330 MB across six payloads and runs a 31-check sweep.
# That is the wrong tool for "I tweaked an alias". This syncs just the shell
# dotfiles, in a couple of ssh connections, in about a second.
#
# Source of truth is the override directory (which is a GIT repo -- that is what
# makes any of this recoverable), and pwn-nvim-sync delegates its bash-env step
# to this script, so the two can never disagree about the dojo's shell env:
#
#   ~/notes/pwn-college-nvim/overrides/
#     bashrc        -> ~/.bashrc
#     inputrc       -> ~/.inputrc          (readline: vi mode, I/N indicator)
#     bash_profile  -> ~/.bash_profile     (login shells read THIS, not .bashrc)
#     starship.toml -> ~/.config/starship.toml
#     pwn.conf      -> ~/.pwn.conf         (pwntools gdb.attach -> tmux split)
#     gdbinit       -> ~/.gdbinit          (persistent history + intel syntax)
#
# The push is a VERBATIM copy -- no templating, no host rewriting -- so the dojo
# copy is byte-identical to the source and a round trip loses nothing. That is
# what makes editing on the dojo and pulling it back safe.
#
# HOW TWO-WAY WORKS
#
# Each file is compared three ways: local source, remote copy, and the BASE --
# the hashes recorded the last time this script successfully synced them
# ($STATE_FILE). Two-way sync without a base cannot tell "you edited the dojo"
# apart from "you edited the source", and guesses wrong half the time.
#
#   in-sync        local == remote                      nothing to do
#   local-ahead    you edited the source                push (the default)
#   remote-ahead   you edited it ON THE DOJO            --pull brings it back
#   conflict       both sides changed since the base    you decide
#   unknown        no base recorded yet, and they differ
#
# A plain push REFUSES to run when anything is remote-ahead or conflicted,
# rather than silently destroying work done on the box.
#
# Adoption is NOT automatic on purpose. On 2026-08-13 a GEF install attempt
# rewrote ~/.gdbinit on the dojo into something broken (it sourced a file that
# the no-network box had failed to download). Auto-pull would have committed
# that breakage into the source of truth. You get shown a diff instead.
#
# Usage:
#   pwn-bash-sync [--dry-run] [--host NAME] [--with-completion] [--no-check]
#   pwn-bash-sync --status          show per-file sync state, change nothing
#   pwn-bash-sync --pull [--yes]    adopt dojo-side edits into the source
#   pwn-bash-sync --force           push even over remote edits (backs up first)
#
#   --with-completion  also push the ~7.6 MB bash-completion tree (rarely
#                      changes, so it is off by default; pwn-nvim-sync passes it)
#   --no-check         skip the post-push sanity check
#   --yes              with --pull, skip the confirmation prompt
set -euo pipefail

HOST=pwn
DRY=()
WITH_COMPLETION=0
CHECK=1
MODE=push
FORCE=0
ASSUME_YES=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY=(--dry-run); shift ;;
    --host) HOST="$2"; shift 2 ;;
    --with-completion) WITH_COMPLETION=1; shift ;;
    --no-check) CHECK=0; shift ;;
    --status) MODE=status; shift ;;
    --pull) MODE=pull; shift ;;
    --force) FORCE=1; shift ;;
    --yes|-y) ASSUME_YES=1; shift ;;
    -h|--help) grep -E '^#( |$)' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

OVERRIDES="$HOME/notes/pwn-college-nvim/overrides"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/pwn-bash-sync"
STATE_FILE="$STATE_DIR/last-sync.sha256"
STAGE="$(mktemp -d)"
PULLED="$(mktemp -d)"
trap 'rm -rf "$STAGE" "$PULLED"' EXIT

# ONE mapping table, used by staging, comparison and pulling alike. Keeping the
# override name and its remote path in a single place is the point: the previous
# version repeated the list three times and they could drift apart.
#   <override filename>:<path relative to $HOME on the dojo>
FILES=(
  "bashrc:.bashrc"
  "inputrc:.inputrc"
  "bash_profile:.bash_profile"
  "pwn.conf:.pwn.conf"
  "gdbinit:.gdbinit"
  "starship.toml:.config/starship.toml"
)

for pair in "${FILES[@]}"; do
  f="${pair%%:*}"
  [[ -f "$OVERRIDES/$f" ]] || { echo "missing override source: $OVERRIDES/$f" >&2; exit 1; }
done

hash_of() { sha256sum "$1" | cut -d' ' -f1; }

# --- gather the three sides ---------------------------------------------------

# Remote hashes, one ssh for the lot. A missing file yields an empty hash, which
# reads as "remote has nothing", not as a spurious difference. The paths are
# %q-quoted into the heredoc so nothing is word-split on the far side.
remote_hashes="$(
  ssh "$HOST" "bash -s" <<REMOTE
for p in $(printf '%q ' "${FILES[@]#*:}"); do
  if [ -f "\$HOME/\$p" ]; then
    printf '%s %s\n' "\$(sha256sum "\$HOME/\$p" | cut -d' ' -f1)" "\$p"
  else
    printf ' %s\n' "\$p"
  fi
done
REMOTE
)"

remote_hash_for() {
  awk -v want="$1" '$2 == want { print $1 }' <<<"$remote_hashes" | head -1
}
base_hash_for() {
  [[ -f "$STATE_FILE" ]] || return 0
  awk -v want="$1" '$2 == want { print $1 }' "$STATE_FILE" | head -1
}

# --- classify -----------------------------------------------------------------

declare -A STATE=()
n_remote_ahead=0
n_conflict=0
n_unknown=0
n_local_ahead=0

for pair in "${FILES[@]}"; do
  f="${pair%%:*}"; rel="${pair#*:}"
  L="$(hash_of "$OVERRIDES/$f")"
  R="$(remote_hash_for "$rel")"
  B="$(base_hash_for "$f")"

  if [[ -z "$R" ]]; then
    STATE[$f]="remote-missing"; n_local_ahead=$((n_local_ahead + 1))
  elif [[ "$L" == "$R" ]]; then
    STATE[$f]="in-sync"
  elif [[ -z "$B" ]]; then
    STATE[$f]="unknown"; n_unknown=$((n_unknown + 1))
  elif [[ "$R" == "$B" ]]; then
    STATE[$f]="local-ahead"; n_local_ahead=$((n_local_ahead + 1))
  elif [[ "$L" == "$B" ]]; then
    STATE[$f]="remote-ahead"; n_remote_ahead=$((n_remote_ahead + 1))
  else
    STATE[$f]="conflict"; n_conflict=$((n_conflict + 1))
  fi
done

print_status() {
  printf '%-16s %-14s %s\n' FILE STATE MEANING
  for pair in "${FILES[@]}"; do
    f="${pair%%:*}"
    case "${STATE[$f]}" in
      in-sync)        m="identical on both sides" ;;
      local-ahead)    m="source edited -- push will send it" ;;
      remote-ahead)   m="EDITED ON THE DOJO -- run --pull to keep it" ;;
      conflict)       m="BOTH sides changed since last sync" ;;
      unknown)        m="differs, and no base recorded -- inspect before syncing" ;;
      remote-missing) m="not on the dojo yet -- push will create it" ;;
    esac
    printf '%-16s %-14s %s\n' "$f" "${STATE[$f]}" "$m"
  done
}

record_base() {
  mkdir -p "$STATE_DIR"
  : >"$STATE_FILE"
  local pair f
  for pair in "${FILES[@]}"; do
    f="${pair%%:*}"
    printf '%s  %s\n' "$(hash_of "$OVERRIDES/$f")" "$f" >>"$STATE_FILE"
  done
}

# --- --status -----------------------------------------------------------------

if [[ "$MODE" == status ]]; then
  print_status
  [[ -f "$STATE_FILE" ]] || echo $'\nno base recorded yet -- it is written after the first successful sync'
  exit 0
fi

# --- --pull -------------------------------------------------------------------

if [[ "$MODE" == pull ]]; then
  if [[ $((n_remote_ahead + n_conflict + n_unknown)) -eq 0 ]]; then
    echo "nothing to pull -- no dojo-side edits"
    record_base
    exit 0
  fi

  echo "==> fetching the dojo's copies"
  for pair in "${FILES[@]}"; do
    f="${pair%%:*}"; rel="${pair#*:}"
    case "${STATE[$f]}" in remote-ahead|conflict|unknown) ;; *) continue ;; esac
    mkdir -p "$PULLED/$(dirname "$rel")"
    rsync -a "$HOST:$rel" "$PULLED/$rel"
  done

  candidates=()
  for pair in "${FILES[@]}"; do
    f="${pair%%:*}"; rel="${pair#*:}"
    case "${STATE[$f]}" in remote-ahead|conflict|unknown) ;; *) continue ;; esac
    echo
    echo "======================================================================"
    echo "  $f   [${STATE[$f]}]   (dojo ~/$rel)"
    echo "======================================================================"
    diff -u --label "source/$f" "$OVERRIDES/$f" --label "dojo/$rel" "$PULLED/$rel" || true
    if [[ "${STATE[$f]}" != "remote-ahead" && "$FORCE" -ne 1 ]]; then
      echo "  ^ NOT auto-adoptable (${STATE[$f]}). Re-run with --force to take the dojo version,"
      echo "    or edit $OVERRIDES/$f by hand."
      continue
    fi
    candidates+=("$f:$rel")
  done

  if [[ ${#candidates[@]} -eq 0 ]]; then
    echo
    echo "nothing adopted."
    exit 1
  fi

  echo
  echo "about to overwrite these source files with the dojo's versions:"
  printf '  %s\n' "${candidates[@]%%:*}"
  echo "(the source is a git repo -- 'git -C ~/notes diff' then commit or revert)"

  if [[ ${#DRY[@]} -gt 0 ]]; then
    echo "(dry run -- nothing written)"
    exit 0
  fi

  if [[ "$ASSUME_YES" -ne 1 ]]; then
    read -r -p "adopt? [y/N] " ans </dev/tty
    [[ "$ans" =~ ^[Yy]$ ]] || { echo "aborted."; exit 1; }
  fi

  for c in "${candidates[@]}"; do
    f="${c%%:*}"; rel="${c#*:}"
    cp "$PULLED/$rel" "$OVERRIDES/$f"
    echo "  adopted $f"
  done

  # Syntax-gate what we just took in: a broken bashrc adopted into the source of
  # truth would be pushed straight back out to every future sync.
  for f in bashrc bash_profile; do
    if ! err="$(bash -n "$OVERRIDES/$f" 2>&1)"; then
      echo "WARNING -- adopted $f has a SYNTAX ERROR:" >&2
      echo "$err" | sed 's/^/    /' >&2
      echo "fix it before pushing (git -C ~/notes diff)" >&2
    fi
  done

  record_base
  echo
  echo "done. review with: git -C ~/notes diff -- pwn-college-nvim/overrides"
  exit 0
fi

# --- push ---------------------------------------------------------------------

# Refuse to bulldoze work done on the dojo. The backup step below is the last
# line of defence, not the first: being told BEFORE the overwrite is the point.
if [[ "$FORCE" -ne 1 ]] && [[ $((n_remote_ahead + n_conflict + n_unknown)) -gt 0 ]]; then
  echo "REFUSING TO PUSH -- the dojo has changes that are not in the source:" >&2
  echo >&2
  print_status >&2
  echo >&2
  echo "  pwn-bash-sync --pull     inspect the diffs and adopt the dojo's version" >&2
  echo "  pwn-bash-sync --force    discard them and push anyway (backed up first)" >&2
  exit 1
fi

# Syntax-gate the two files that bash actually SOURCES. Shipping a broken rc
# means every new login on the dojo spews errors, and you get to debug it with
# a half-configured shell. Cheap insurance; refuse to push instead.
for f in bashrc bash_profile; do
  if ! err="$(bash -n "$OVERRIDES/$f" 2>&1)"; then
    echo "REFUSING TO PUSH -- $f has a syntax error:" >&2
    echo "$err" | sed 's/^/    /' >&2
    exit 1
  fi
done

# Stage with the exact remote layout so the whole set goes in ONE rsync (one ssh
# connection) instead of six.
for pair in "${FILES[@]}"; do
  f="${pair%%:*}"; rel="${pair#*:}"
  mkdir -p "$STAGE/$(dirname "$rel")"
  cp "$OVERRIDES/$f" "$STAGE/$rel"
done

# ---------------------------------------------------------------------------
# Snapshot anything we are about to overwrite that we did not write ourselves.
#
# This rsync clobbers six dotfiles in $HOME on the dojo with no undo. That is
# safe against the stock image -- verified: the current dojo writes only
# /etc/gdb/gdbinit.d/dojo.gdb, and the sole ~/.gdbinit in pwn.college's repos is
# challenge-images/legacy/.gdbinit, which sources an /opt/pwndbg + /opt/splitmind
# layout that does not exist on this nix-based box. It is NOT safe against hand
# edits, which is what the divergence gate above is for -- this remains the
# backstop for --force and for anything that changed between the two.
#
# So: before writing, copy any target whose content differs from what we are
# about to install into a timestamped backup dir on the dojo. One extra ssh,
# hashes only, and it makes "what did I have before?" answerable.
if [[ ${#DRY[@]} -eq 0 ]]; then
  manifest=""
  while IFS= read -r -d '' f; do
    manifest+="$(hash_of "$f")  ${f#"$STAGE"/}"$'\n'
  done < <(find "$STAGE" -type f -print0)

  # The manifest travels as a base64 ENV VAR, not on stdin. `ssh 'bash -s'
  # <<'REMOTE'` already spends stdin on the heredoc that carries the script, so
  # piping the manifest in as well silently delivers nothing and the loop below
  # backs up zero files -- which is exactly how the first version of this failed.
  manifest_b64=$(printf '%s' "$manifest" | base64 -w0)

  ssh "$HOST" "PBS_MANIFEST_B64='$manifest_b64' bash -s" <<'REMOTE' \
    || echo "   warn: pre-push backup step failed (continuing)" >&2
set -u
stamp=$(date -u +%Y%m%dT%H%M%SZ)
root="$HOME/.local/share/pwn-bash-sync/backups"
dir="$root/$stamp"
saved=0
while read -r want rel; do
  [ -n "${rel:-}" ] || continue
  target="$HOME/$rel"
  [ -f "$target" ] || continue                  # nothing there = nothing to lose
  have=$(sha256sum "$target" | cut -d' ' -f1)
  [ "$have" = "$want" ] && continue             # identical: this push is a no-op
  mkdir -p "$dir/$(dirname "$rel")"
  cp -p "$target" "$dir/$rel"
  saved=$((saved + 1))
done <<< "$(printf '%s' "$PBS_MANIFEST_B64" | base64 -d)"
if [ "$saved" -gt 0 ]; then
  echo "   backed up $saved pre-existing file(s) -> ~/.local/share/pwn-bash-sync/backups/$stamp"
else
  rmdir "$dir" 2>/dev/null || true
fi
# Keep the 10 newest snapshots; they are a few KB each.
ls -1d "$root"/*/ 2>/dev/null | sort | head -n -10 | xargs -r rm -rf
REMOTE
fi

echo "==> pushing shell env -> $HOST"
# No --delete: this writes only the staged files and must not touch anything
# else in $HOME on the dojo.
rsync -a --info=stats1 "${DRY[@]}" "$STAGE/" "$HOST:"

if [[ "$WITH_COMPLETION" -eq 1 ]]; then
  if [[ -r /usr/share/bash-completion/bash_completion ]]; then
    echo "==> pushing bash-completion (~7.6M, pure shell)"
    rsync -a --delete --info=stats1 "${DRY[@]}" \
      /usr/share/bash-completion/ "$HOST:.local/share/bash-completion/"
  else
    echo "   warn: /usr/share/bash-completion not found locally, skipping" >&2
  fi
fi

if [[ ${#DRY[@]} -gt 0 ]]; then
  echo "(dry run -- nothing written)"
  exit 0
fi

# Both sides now match the source: that is the new base for the next comparison.
record_base

[[ "$CHECK" -eq 1 ]] || exit 0

# One ssh for the whole check. A login shell must be SILENT: anything printed
# here is what you would see on every `ssh pwn`.
#
# -tt is load-bearing: without a controlling terminal, `bash -lic` emits
# "cannot set terminal process group" + "no job control in this shell", which
# have nothing to do with the rc and would be a permanent false positive on the
# silence check. A real `ssh pwn` has a TTY, so test with one.
echo "==> checking"
out="$(ssh -tt "$HOST" 'bash -lic "
  printf \"VI=%s\n\" \"\$(shopt -po vi 2>/dev/null)\"
  printf \"HEAL=%s\n\" \"\$(type -t __heal_kbd_protocol 2>/dev/null)\"
  printf \"MODE=%s\n\" \"\$(bind -v 2>/dev/null | grep -c \"show-mode-in-prompt on\")\"
  printf \"COMP=%s\n\" \"\$(type -t _comp_load 2>/dev/null || type -t _completion_loader 2>/dev/null)\"
"' 2>&1 </dev/null | tr -d '\r')"

# Drop our own result lines and ssh's own closing notice; whatever is left is
# genuine login noise.
noise="$(grep -avE '^(VI|HEAL|MODE|COMP)=' <<<"$out" \
         | grep -avE '^Connection to .* closed\.$' \
         | grep -av '^$' || true)"

status=0
grep -q 'VI=set -o vi'   <<<"$out" || { echo "  FAIL: vi mode not set";              status=1; }
grep -q 'HEAL=function'  <<<"$out" || { echo "  FAIL: __heal_kbd_protocol missing";  status=1; }
grep -q 'MODE=1'         <<<"$out" || { echo "  FAIL: vi mode indicator off";        status=1; }
grep -q 'COMP=function'  <<<"$out" || { echo "  warn: bash-completion not loaded (try --with-completion)"; }

if [[ -n "$noise" ]]; then
  echo "  FAIL: login shell is NOT silent -- you would see this on every ssh:"
  echo "$noise" | sed 's/^/      /'
  status=1
fi

if [[ "$status" -eq 0 ]]; then
  echo "  OK -- vi mode, mode indicator, kbd heal, silent login"
  echo "  (reconnect: readline only re-reads ~/.inputrc on a fresh login)"
fi
exit "$status"
