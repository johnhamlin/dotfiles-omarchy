#!/usr/bin/env bash
# Toggle gaming mode: single monitor, hardware cursors, no eye candy.
# Rewritten for Omarchy (was HyDE-coupled via gaming.conf + gamemode.lck).
set -euo pipefail
LCK="${XDG_RUNTIME_DIR:-/tmp}/gaming-mode.lck"

if [[ -f $LCK ]]; then
  rm -f "$LCK"
  # Restore everything from config (monitors, animations, blur, shadows, cursors)
  hyprctl reload
  # no_hardware_cursors=true is restored by input.conf on reload (multi-monitor NVIDIA fix)
  notify-send "Gaming mode OFF" "Monitors + effects restored"
else
  touch "$LCK"
  hyprctl keyword monitor "DP-2, disable"
  hyprctl keyword monitor "DP-3, disable"
  # Single monitor: hardware cursors are safe (the NVIDIA bug is at rotated boundaries)
  hyprctl keyword cursor:no_hardware_cursors false
  hyprctl keyword animations:enabled 0
  hyprctl keyword decoration:blur:enabled 0
  hyprctl keyword decoration:shadow:enabled 0
  powerprofilesctl set performance || true
  notify-send "Gaming mode ON" "DP-2/DP-3 off, HW cursors, effects off"
fi
