#!/usr/bin/env python3
"""Manage an unmodified, pinned lazy-idea checkout; personal Vim files stay separate."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile


def run(*args):
    result = subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or f'{args[0]} failed')
    return result.stdout.strip()


def git(repo, *args):
    return run('git', '-C', str(repo), *args)


def sha(value):
    if not isinstance(value, str) or not re.fullmatch('[0-9a-f]{40}', value):
        raise RuntimeError('Revision must be a full lowercase 40-character commit SHA')
    return value


def validate_tree(repo, revision):
    """Structural check, not a security audit of upstream Vimscript."""
    sha(revision)
    def regular(path):
        entries = git(repo, 'ls-tree', revision, '--', path).splitlines()
        if len(entries) != 1 or not entries[0].startswith(('100644 blob ', '100755 blob ')):
            raise RuntimeError(f'Target lacks regular file: {path}')
        return git(repo, 'show', f'{revision}:{path}')
    loader = regular('lazy-idea.vim')
    sources = re.findall(r'^\s*source\s+~/.lazy-idea/([^\s]+)\s*$', loader, re.MULTILINE)
    if not sources:
        raise RuntimeError('Target loader has no recognized module sources; review upstream structure')
    for source in sources:
        if '..' in Path(source).parts or source.startswith('/'):
            raise RuntimeError(f'Unexpected module path: {source}')
        regular(source)


def clean(repo, pin):
    if repo.is_symlink() or not (repo / '.git').is_dir():
        raise RuntimeError('Checkout must be a standalone Git directory, not a symlink or worktree')
    if git(repo, 'remote', 'get-url', 'origin') != pin['origin']:
        raise RuntimeError('Checkout origin differs from pin origin')
    if git(repo, 'rev-parse', 'HEAD') != pin['revision']:
        raise RuntimeError('Checkout HEAD differs from pin; reconcile manually')
    if git(repo, 'status', '--porcelain', '--untracked-files=all', '--ignored'):
        raise RuntimeError('Checkout has tracked, untracked, or ignored changes; preserve/reconcile them first')
    validate_tree(repo, pin['revision'])


def atomic_write(path, data):
    mode = path.stat().st_mode & 0o777
    fd, name = tempfile.mkstemp(prefix=f'.{path.name}.', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(name, mode)
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--config', type=Path, help='Standalone authoritative JSON pin (default: chezmoi source with targeted apply)')
    parser.add_argument('--checkout', type=Path, default=Path.home() / '.lazy-idea')
    parser.add_argument('command', choices=['bootstrap', 'status', 'check', 'update', 'rollback'])
    parser.add_argument('revision', nargs='?')
    args = parser.parse_args()
    if (args.command == 'update') != (args.revision is not None):
        parser.error('Only update takes a revision, and requires it')
    deployed = Path.home() / '.config/ideavim/upstream.json'
    source = args.config or Path(run('chezmoi', 'source-path', str(deployed)))
    if source.is_symlink():
        raise RuntimeError('Pin source must be a regular file, not a symlink')
    repo = args.checkout.absolute()
    state = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'lazy-idea-manage'
    state.mkdir(parents=True, exist_ok=True)
    lock_name = hashlib.sha256(str(repo.resolve()).encode()).hexdigest() + '.lock'
    with (state / lock_name).open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        old_bytes = source.read_bytes()
        pin = json.loads(old_bytes)
        sha(pin['revision'])
        if pin.get('previous') is not None:
            sha(pin['previous'])
        if not isinstance(pin.get('origin'), str) or not pin['origin'] or pin['origin'].startswith('-'):
            raise RuntimeError('Pin requires an origin URL or local repository path')
        if args.command == 'bootstrap':
            if repo.exists() or repo.is_symlink():
                raise RuntimeError('Bootstrap refuses an existing checkout path')
            repo.parent.mkdir(parents=True, exist_ok=True)
            # Preserve a failed temporary clone for diagnosis; never delete unknown files.
            temporary = Path(tempfile.mkdtemp(prefix='.lazy-idea-bootstrap-', dir=repo.parent))
            try:
                run('git', 'clone', '--no-checkout', '--origin', 'origin', '--', pin['origin'], str(temporary))
                validate_tree(temporary, pin['revision'])
                git(temporary, 'checkout', '--detach', pin['revision'])
                clean(temporary, pin)
                if repo.exists() or repo.is_symlink():
                    raise RuntimeError('Checkout path appeared during bootstrap')
                temporary.rename(repo)
            except Exception:
                print(f'Bootstrap temporary checkout retained: {temporary}', file=sys.stderr)
                raise
            print(f'Bootstrapped {repo} at {pin["revision"]}')
            return
        clean(repo, pin)
        if args.command == 'status':
            print(f'Clean {repo}\nPinned: {pin["revision"]}\nPrevious: {pin.get("previous")}\nOrigin: {pin["origin"]}')
            return
        if args.command in ('check', 'update'):
            git(repo, 'fetch', 'origin', 'refs/heads/main:refs/remotes/origin/main')
            candidate = git(repo, 'rev-parse', 'refs/remotes/origin/main')
        if args.command == 'check':
            print(f'Candidate: {candidate}')
            print(git(repo, 'log', '--oneline', f'{pin["revision"]}..{candidate}'))
            print(git(repo, 'diff', pin['revision'], candidate, '--'))
            return
        target = sha(args.revision if args.command == 'update' else pin.get('previous'))
        if args.command == 'update':
            git(repo, 'merge-base', '--is-ancestor', target, 'refs/remotes/origin/main')
        validate_tree(repo, target)
        if target == pin['revision']:
            print('Already at requested revision')
            return
        print(git(repo, 'diff', pin['revision'], target, '--'))
        # Recheck after fetch/inspection, before checkout. Never force or clean files.
        clean(repo, pin)
        if source.read_bytes() != old_bytes:
            raise RuntimeError('Pin changed during operation')
        git(repo, 'checkout', '--detach', target)
        try:
            updated = dict(pin, revision=target, previous=pin['revision'])
            atomic_write(source, (json.dumps(updated, indent=2) + '\n').encode())
            if args.config is None:
                run('chezmoi', 'apply', str(deployed))
        except Exception as error:
            problems = []
            for operation in (lambda: atomic_write(source, old_bytes),
                              lambda: git(repo, 'checkout', '--detach', pin['revision'])):
                try:
                    operation()
                except Exception as restore_error:
                    problems.append(str(restore_error))
            if args.config is None:
                try:
                    run('chezmoi', 'apply', str(deployed))
                except Exception as restore_error:
                    problems.append(str(restore_error))
            if problems:
                raise RuntimeError(f'Update failed: {error}; recovery needs attention: {problems}') from error
            raise RuntimeError(f'Update failed; previous checkout and pin restored: {error}') from error
        print(f'Pinned {target}; previous {pin["revision"]}. Reload IdeaVim and commit the pin source after verification.')


if __name__ == '__main__':
    try:
        main()
    except (RuntimeError, OSError, ValueError, KeyError) as error:
        print(f'lazy-idea-manage: {error}', file=sys.stderr)
        sys.exit(1)
