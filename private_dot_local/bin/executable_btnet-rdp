#!/bin/sh
pw=$(rofi -dmenu -password -p "BTNet password" -lines 0) || exit 0
[ -z "$pw" ] && exit 0
printf '%s\n' "$pw" | exec xfreerdp3 \
  /f \
  /u:john.hamlin \
  /d:BT \
  /v:100.114.178.68 \
  /sec:tls \
  /from-stdin \
  +fonts +themes +clipboard \
  -wallpaper -window-drag -menu-anims -aero \
  /dynamic-resolution \
  /floatbar \
  /scale:140 \
  /gfx:RFX \
  /auto-reconnect \
  /auto-reconnect-max-retries:20
